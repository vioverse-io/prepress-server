# Windows Authentication -- the Node process must run as a Windows
# account that has db_datareader + db_datawriter on STS_WorkOrder.
# No SQL username/password needed.

SQL_SERVER=192.168.1.x
SQL_PORT=1433
SQL_DATABASE=STS_WorkOrder
SQL_AUTH=windows
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERT=true

# ODBC driver name -- must match what's installed on the app server.
# Check: odbcad32 > Drivers tab, or PowerShell:
#   Get-OdbcDriver | Where-Object Name -like '*SQL Server*' | Select-Object Name
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# User list: the names people pick from when they open the app. This is an
# approved honor-system user picker, not a sign-in: nobody types a password.
# A CSV file with a column headed User, one person per row as
# Firstname.Lastname (for example David.Marra). See users.example.csv and
# README.md. A path relative to this folder, as here (the app folder,
# C:\Apps\STS_WorkOrder), or an absolute path. The app will
# not let anyone in without it; /api/health shows users: "ok" once it loads.
# Changes to the file apply within seconds, with no restart.
USER_LIST_FILE=users.csv

# How long a picked name is remembered in a browser without the app being
# used, in minutes. 720 is 12 hours: people pick their name again each morning.
USER_REMEMBER_MINUTES=720

# ── Email (QC Review) ──
# The app never sends an email. When a QC Review press would tell somebody
# (a new job sent to a department, sent for review, corrections needed, fixed
# and ready for re-review, a job signed back in, a request to send the files
# to the CSR, a checklist passed, the outputs sent on to the CSR), a ready
# Outlook message opens on that person's own screen, filled in, and they press
# Send. No mail server, no password, nothing to sign in to. Two lines make it
# work; with both empty nothing opens anywhere and the rest of the app is the
# same. /api/health shows mail: "off" or "on". Read once at start: a change
# needs a service restart.
#
# The address people open the app at. It is what the link in every email uses,
# so it has to work from their computers.
APP_BASE_URL=http://192.168.1.x:3000
# The part after the @ in every address. An address is the person's user from
# the user list plus this, so David.Marra becomes david.marra@compu-mail.com.
# Nothing is typed in per person: link each name to a user in
# Manage CSRs & Assignees.
USER_EMAIL_DOMAIN=compu-mail.com

# QC Review: one address per department. When set, an email to that
# department's list (a new job, Sent by mistake, Send for review, a sign back
# in) is addressed to this one address instead of to each person on the list.
# Empty, which is how this ships, means each person on the list is in To.
DEPT_EMAIL_PREPRESS=
DEPT_EMAIL_TECHSERVICES=

# Pasted paths: a path pasted into a path box (File Path, Data file locations,
# the Send to CSR box) loses the quotes Windows' "Copy as path" puts round it,
# and a drive letter named here becomes its server. One line a drive, the
# letter after MAPPED_DRIVE_, the server and share after the =. Never in
# double quotes: there \n is read as a line break. A letter not named keeps
# its letter. Read at start: restart the service after a change. The log says
# which drives it took ("Pasted paths: ...").
#MAPPED_DRIVE_M=\\fileserver\share

PORT=3000
