# Windows Authentication -- the Node process must run as a Windows
# account that has db_datareader + db_datawriter on STS_WorkOrder.
# No SQL username/password needed.

SQL_SERVER=192.168.1.x
SQL_PORT=1433
SQL_DATABASE=STS_WorkOrder
SQL_AUTH=windows
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERT=true

# ODBC driver name -- must match what's installed on the app server.
# Check: odbcad32 > Drivers tab, or PowerShell:
#   Get-OdbcDriver | Where-Object Name -like '*SQL Server*' | Select-Object Name
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Windows login (NTLM). When true, the app is a real gated login: users must
# sign in with their Windows username and password, validated against the
# domain controller below. A wrong password or a cancelled dialog is rejected.
# Leave false (or omit) only for local dev where no domain controller exists.
NTLM_AUTH=true

# Domain controller that validates the login, as an LDAP address.
# REQUIRED whenever NTLM_AUTH=true -- the app will not start without it (it
# refuses to run a login it cannot check). Ask IT for the host. Examples:
#   NTLM_DOMAINCONTROLLER=ldap://dc01.compumail.local
#   NTLM_DOMAINCONTROLLER=ldap://192.168.3.10
# Multiple controllers for failover may be comma-separated.
NTLM_DOMAINCONTROLLER=ldap://your-domain-controller

# Optional: default domain name if it cannot be read from the login.
# NTLM_DOMAIN=COMPUMAIL

PORT=3000
